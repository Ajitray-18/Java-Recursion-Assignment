import java.util.Scanner;
public class Main{
static void printNums(int n) {
    if (n == 0) {
        return;}
    printNums(n - 1);
    System.out.print(n + " ");
}
public static void main(String[] args) {
    Scanner sc = new Scanner(System.in);
    int n = sc.nextInt();
    printNums(n);
    sc.close();
}
}
